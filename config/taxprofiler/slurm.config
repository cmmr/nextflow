// Slurm settings for nf-core/taxprofiler.
//
// Separate from config/slurm.config because taxprofiler is built on the nf-core
// 3.x template, which dropped params.max_cpus / max_memory / max_time in favour
// of process.resourceLimits. The params block in config/slurm.config sets
// nothing taxprofiler reads.
//
// Compute nodes have 32 cores and 1 TB of RAM, with node-local NVMe under /tmp.
// Databases are read over the shared filesystem through the symlink Nextflow
// stages them as; nothing copies them.

process {
    executor       = 'slurm'
    scratch        = true
    resourceLimits = [ cpus: 32, memory: 900.GB, time: 24.h ]

    // Point TMPDIR at the per-task scratch directory, which Nextflow creates on
    // the node's /tmp and removes when the task exits. Without this, a tool that
    // caches under $TMPDIR writes to one directory shared by every task on the
    // node, and concurrent tasks delete each other's files: apptainer runs each
    // container in its own PID namespace, so anything keyed on a pid collides.
    beforeScript   = 'export TMPDIR=$NXF_SCRATCH'

    // kraken2 reads hash.k2d into its own heap: 110 GB for pluspf_20260626, plus
    // the read batch. Two of these fit a 1 TB node, and 16 cpus puts two there
    // anyway. Re-check this against ls -l on hash.k2d after a database update.
    withName: 'KRAKEN2_KRAKEN2' {
        cpus   = 16
        memory = 128.GB
    }

    // Host depletion aligns against one host genome plus PhiX - 3.1 Gbp at most,
    // so a small (.bt2) index of roughly 4 GB. 16 GB was not enough: a task on
    // run yl2ofmem peaked at 16.8 GiB, over its own reservation.
    withName: 'BOWTIE2_ALIGN' {
        cpus   = 16
        memory = 24.GB
    }

    // bowtie2 against the 22 GB marker index, and usually the longest step
    withName: 'METAPHLAN_METAPHLAN' {
        cpus   = 16
        memory = 48.GB
    }

    // mOTUs maps against the marker gene catalogue with bwa, a 3.5 GB index it
    // holds in memory alongside the read batch
    withName: 'MOTUS_PROFILE' {
        cpus   = 16
        memory = 32.GB
    }

    // Nonpareil is given whatever is reserved here and no more: the module
    // passes task.memory to its -R, and k-mer mode fills what it is given with
    // the k-mer table it builds over the reads. A reservation that is too small
    // is a coarser estimate rather than a failure, but 3 Gbp of R1 wants room.
    //
    // A sample it cannot measure is one sample's diversity, not a failed run.
    // Nonpareil is a reading about the reads rather than a step that produces
    // them: nothing downstream consumes its output, the pages plot whichever
    // samples it managed, and the alternative is losing an hour of profiling
    // over a curve that would not fit. TAXPROFILER_01.sh sets the read length
    // that keeps it from failing in the first place; this is the net under it.
    //
    // Retried before it is ignored, so a sample lost to the transient read
    // errors below is not silently missing from the diversity table.
    withName: 'NONPAREIL_NONPAREIL' {
        cpus          = 8
        memory        = 64.GB
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
    }

    // The steps that read the requester's own FASTQ files, retried on any
    // failure rather than on the exit codes alone.
    //
    // taxprofiler_samplesheet.sh symlinks already-gzipped input into
    // raw-sequences/ rather than copying it, so these four read from wherever
    // the sequencing centre left the data for as long as the run lasts. On run
    // i6hehgpw four of ten FASTQC tasks died two minutes in, all of them on
    // "java.io.IOException: Operation not permitted" against a raw FASTQ on the
    // /SeqCenter GPFS fileset - spread across three nodes, unrelated to file
    // size, on files that read back clean immediately afterwards and could not
    // be made to fail again. The root cause is in the storage layer rather than
    // here; what is fixable here is that one such read cost a whole run.
    //
    // nf-core's own strategy covers exit 104 and 130-145, which a tool that has
    // hit an I/O error is not among: FastQC returns 1, and 1 terminates.
    // "finish" rather than "terminate" once the retries are spent, which is
    // what taxprofiler's base config does - the tasks already running are
    // allowed to land.
    withName: 'FASTQC|FASTQC_PROCESSED|FASTP_SINGLE|FASTP_PAIRED' {
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    // taxpasta 0.7.0 cannot merge MetaPhlAn profiles carrying two clades that
    // share one NCBI taxon id, which mpa_vJun23 has. Its merge is allowed to
    // fail; the kraken2 and bracken ones still have to pass, and so does any
    // MetaPhlAn merge whose tag cannot be read.
    withName: 'TAXPASTA_MERGE' {
        errorStrategy = { task.tag?.toString()?.startsWith('metaphlan') ? 'ignore' : 'terminate' }
    }
}

// Apptainer Container Configuration & Persistent Image Cache
apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/data/prod/nextflow/cache/apptainer'
    runOptions = '-B /tmp:/tmp'
}
