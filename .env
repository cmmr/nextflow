# Non-Secret Environment Variables for Nextflow Runs
#
# Every statement here is a plain assignment or a source, so this file is safe
# and cheap to source any number of times, in any process. It needs no guard:
# PATH is deliberately left alone, and everything in this project is invoked by
# its absolute path instead, which is also what makes a bare word in these
# scripts recognizable as a shell function rather than an executable.

export NEXTFLOW_DIR="/data/prod/nextflow"

# Compute node that Wrike jobs and their nextflow tasks are pinned to.
# wrike_task_handler.sh passes it to sbatch; config/slurm.config reads it
# for the nextflow tasks, falling back to cmp09 when run outside this env.
export NEXTFLOW_NODE="cmp09"

# Everything this system publishes lives under one key prefix in the bucket, so
# that runs do not crowd the top level and a website can be built around them
# later. Read by wrike_task_handler.sh, ampliseq_upload.sh, nextflow_progress.sh
# and wrike_delete_handler.sh, which must all agree - changing it orphans
# everything already published under the old one.
export S3_RUN_PREFIX="nxf"

export NXF_ASSET_DIR="$NEXTFLOW_DIR/assets"
export NXF_APPTAINER_CACHEDIR="$NEXTFLOW_DIR/cache/apptainer"
export NXF_SINGULARITY_CACHEDIR="$NEXTFLOW_DIR/cache/apptainer"

# Credentials only - WRIKE_API_TOKEN, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION, AWS_REGION, AWS_SQS_QUEUE_URL,
# AWS_S3_BUCKET - and never committed
source "$NEXTFLOW_DIR/secrets/.env"

# The log, warn, and fail helpers everything below reports through
source "$NEXTFLOW_DIR/scripts/utilities.sh"

# The Wrike helper functions, plus the Wrike object IDs they act on:
# WRIKE_DASHBOARDS_FOLDER_ID, WRIKE_NXFPIPE_SPACE_ID, WRIKE_NXFPIPE_WORKFLOW_ID,
# WRIKE_NXFPIPE_REQUEST_FORM_ID, WRIKE_PIPELINE_NAME_CFID,
# WRIKE_S3_RESULTS_URL_CFID, and the WRIKE_CUSTOM_STATUS_IDS map. None are
# secret - they are opaque references, useless without WRIKE_API_TOKEN - so
# they live in git next to the code that uses them.
source "$NEXTFLOW_DIR/scripts/wrike_api.sh"
