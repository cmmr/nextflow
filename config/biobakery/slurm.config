// Slurm settings for workflows/biobakery on the CMMR cluster.
//
// Compute nodes have 32 cores and 1 TB of RAM, with node-local NVMe under /tmp.
// Images are cached where NXF_APPTAINER_CACHEDIR points, which .env sets.
// Databases are read over the shared filesystem through the symlinks Nextflow
// stages them as.

process {
    executor       = 'slurm'
    scratch        = true
    resourceLimits = [ cpus: 32, memory: 900.GB, time: 24.h ]

    // A private TMPDIR per task, in the scratch directory Nextflow removes
    beforeScript   = 'export TMPDIR=$NXF_SCRATCH'

    // bowtie2 against a host index of about 4 GB, and Trimmomatic's heap
    withName: 'KNEADDATA' {
        cpus   = 16
        memory = { 32.GB * task.attempt }
    }

    // bowtie2 against the 22 GB marker index
    withName: 'METAPHLAN' {
        cpus   = 16
        memory = { 48.GB * task.attempt }
    }
}

apptainer {
    enabled    = true
    autoMounts = true
    runOptions = '-B /tmp:/tmp'
}
