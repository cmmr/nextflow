params {
    // Resource Capping
    max_cpus   = 32
    max_memory = 900.GB
    max_time   = 24.h
}

// Slurm Execution Settings
process {
    executor       = 'slurm'
    clusterOptions = '--nodelist=cmp09'
}

// Top-Level Environment Variables (Exported to all child processes/containers)
env {
    TMPDIR              = '$TMPDIR'
    APPTAINERENV_TMPDIR = '$TMPDIR'
}

// Apptainer Container Configuration & Persistent Image Cache
apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/data/prod/nextflow/cache/apptainer'
    runOptions = '-B $TMPDIR'
}
