// Slurm settings for workflows/biobakery on the CMMR cluster.
//
// Compute nodes have 32 cores and 1 TB of RAM. /tmp is on the node's root
// filesystem, a 431 GB NVMe partition with about 410 GB free.
// Images are cached where NXF_APPTAINER_CACHEDIR points, which .env sets.
// Databases are read over the shared filesystem through the symlinks Nextflow
// stages them as.

process {
    executor       = 'slurm'
    scratch        = true
    resourceLimits = [ cpus: 32, memory: 900.GB, time: 24.h ]

    // A private TMPDIR per task, in the scratch directory Nextflow removes
    beforeScript   = 'export TMPDIR=$NXF_SCRATCH'

    // bowtie2 against a host index of about 4 GB, over each run's reads as a
    // stream: on disk only the reads it keeps, at most the run's gzipped size.
    // A deep run can take it past 12 hours, so every attempt has the full 24.
    withName: 'HOST_DEPLETION' {
        cpus   = 16
        memory = { 16.GB * task.attempt }
        time   = 24.h
    }

    // Trimmomatic's heap. KneadData needs about twenty times a sample's
    // gzipped size on disk at once, counting what host depletion left, so
    // /tmp fits a sample of about 20 GB gzipped, or half that with a second
    // KneadData task on the node. It runs in its work directory on the shared
    // filesystem instead. A deep sample with little host can take it past 12
    // hours, so every attempt has the full 24.
    withName: 'KNEADDATA' {
        cpus         = 16
        memory       = { 32.GB * task.attempt }
        time         = 24.h
        scratch      = false
        beforeScript = 'export TMPDIR=$PWD'
    }

    // bowtie2 against the 22 GB marker index
    withName: 'METAPHLAN' {
        cpus   = 16
        memory = { 48.GB * task.attempt }
    }

    // bwa against the 3.5 GB marker gene catalogue
    withName: 'MOTUS' {
        cpus   = 16
        memory = { 32.GB * task.attempt }
    }

    // k-mer mode fills the memory it is given (-R) with its k-mer table
    withName: 'NONPAREIL' {
        cpus   = 8
        memory = 64.GB
    }

    // minimap2 against the 650 MB index of the virus database
    withName: 'ESVIRITU' {
        cpus   = 16
        memory = { 16.GB * task.attempt }
    }

    // minimap2 against the 10.5 GB marker gene catalogue, indexed in chunks
    withName: 'MARKERMAGU' {
        cpus   = 16
        memory = { 96.GB * task.attempt }
    }

    // HUMAnN decompresses a sample's reads into its temporary folder and writes
    // bowtie2's alignments of every one of them beside it, about four times
    // the sample's uncompressed size at once, so it runs in its work directory
    // on the shared filesystem as KneadData does
    withName: 'HUMANN_PROFILE' {
        scratch      = false
        beforeScript = 'export TMPDIR=$PWD'
    }
}

apptainer {
    enabled    = true
    autoMounts = true
    runOptions = '-B /tmp:/tmp'
}
