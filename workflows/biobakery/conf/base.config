// Resources and retries for workflows/biobakery, by process. A site config
// passed with -c resizes these to its nodes and caps them with resourceLimits.

process {
    cpus   = 1
    memory = 4.GB
    time   = 4.h

    // Both read the requester's reads or a database over a shared filesystem,
    // so a failure is retried before the run stops
    withName: 'KNEADDATA' {
        cpus          = 8
        memory        = { 16.GB * task.attempt }
        time          = { 12.h  * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    withName: 'METAPHLAN' {
        cpus          = 8
        memory        = { 32.GB * task.attempt }
        time          = { 12.h  * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    withName: 'MOTUS' {
        cpus          = 8
        memory        = { 16.GB * task.attempt }
        time          = { 8.h   * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    // A sample Nonpareil cannot measure is left out of the diversity table
    // rather than failing the run
    withName: 'NONPAREIL' {
        cpus          = 8
        memory        = { 16.GB * task.attempt }
        time          = { 8.h   * task.attempt }
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
    }

    withName: 'NONPAREIL_CURVES' {
        memory        = 8.GB
        errorStrategy = 'ignore'
    }

    withName: 'ESVIRITU' {
        cpus          = 8
        memory        = { 16.GB * task.attempt }
        time          = { 8.h   * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    withName: 'ESVIRITU_SUMMARY' {
        cpus          = 2
        memory        = 8.GB
    }

    // minimap2 holds the whole 10.5 GB marker catalogue, split into chunks
    withName: 'MARKERMAGU' {
        cpus          = 8
        memory        = { 72.GB * task.attempt }
        time          = { 12.h  * task.attempt }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    withName: 'MARKERMAGU_MERGE' {
        cpus          = 2
        memory        = 8.GB
    }

    // A sample HUMAnN cannot finish is retried with more of both, then left out
    // of the tables rather than failing the run
    withName: 'HUMANN_PROFILE' {
        cpus          = 16
        memory        = { 64.GB * task.attempt }
        time          = { 20.h  * task.attempt }
        errorStrategy = { task.attempt < 2 ? 'retry' : 'ignore' }
        maxRetries    = 1
    }

    withName: 'HUMANN_TABLES' {
        cpus          = 2
        memory        = 64.GB
        time          = 8.h
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
        maxRetries    = 3
    }

    // The report is a convenience; the run does not fail for want of one
    withName: 'MULTIQC' {
        cpus          = 2
        memory        = 8.GB
        errorStrategy = 'ignore'
    }
}
