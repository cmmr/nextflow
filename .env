# Non-Secret Environment Variables for Nextflow Runs
#
# Sourced by every script here. Contains only assignments, unsets, and sources,
# so it is safe to source any number of times. PATH is left alone; everything in
# this project is invoked by absolute path, so a bare word in these scripts is a
# shell function.

export NEXTFLOW_DIR="/data/prod/nextflow"

# The guest collection the bulky downloads are served from: where it is rooted
# on this host, which collection it is, and the domain it answers on. A run's
# raw reads and the zip of its dashboard are written under GLOBUS_DIR and linked
# from the dashboard as GLOBUS_URL, so neither ever reaches S3.
export GLOBUS_DIR="/SeqCenter/Globus/Nextflow"
export GLOBUS_UUID="906ce447-a02f-4b41-a7f2-6237c243cb8a"
export GLOBUS_URL="https://g-8d60ea.bd9c6d.eb38.data.globus.org"

# The one subpath of that collection every run publishes under. A single
# anonymous read permission is granted on it once - see docs/operations/globus.md
# - so a run is a directory under this rather than a permission of its own.
# Changing it orphans everything already published, and leaves the new path
# unreadable until a permission is granted on it.
export GLOBUS_RUN_PREFIX="nxf"

# The key prefix everything this system publishes lives under. Read by
# wrike_task_handler.sh, ampliseq_upload.sh, nextflow_progress.sh and
# wrike_delete_handler.sh, which must all agree - changing it orphans everything
# already published under the old one.
export S3_RUN_PREFIX="nxf"

export NXF_ASSET_DIR="$NEXTFLOW_DIR/assets"
export NXF_APPTAINER_CACHEDIR="$NEXTFLOW_DIR/cache/apptainer"
export NXF_SINGULARITY_CACHEDIR="$NEXTFLOW_DIR/cache/apptainer"

# Define JAVA_HOME and add jdk21's bin to the PATH
export JAVA_HOME="$NEXTFLOW_DIR/opt/jdk21"
if [[ ":$PATH:" != *":$JAVA_HOME/bin:"* ]]; then
    export PATH="$JAVA_HOME/bin:$PATH"
fi

# Add apptainer's bin to the PATH
export APPTAINER_HOME="$NEXTFLOW_DIR/opt/apptainer"
if [[ ":$PATH:" != *":$APPTAINER_HOME/bin:"* ]]; then
    export PATH="$APPTAINER_HOME/bin:$PATH"
fi

# Add our bin directory to the PATH
if [[ ":$PATH:" != *":$NEXTFLOW_DIR/bin:"* ]]; then
    export PATH="$NEXTFLOW_DIR/bin:$PATH"
fi


# Everything here talks to Wrike as the Cluster Bot, `run` included. Dropping any
# inherited token keeps that true whoever invokes what.
unset WRIKE_API_TOKEN

# Credentials only - WRIKE_API_TOKEN, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION, AWS_REGION, AWS_SQS_QUEUE_URL,
# AWS_S3_BUCKET - and never committed
source "$NEXTFLOW_DIR/secrets/.env"

# The log, warn, and fail helpers everything below reports through
source "$NEXTFLOW_DIR/scripts/utilities.sh"

# Where a run's raw reads and dashboard zip are written, and the addresses they
# are served from
source "$NEXTFLOW_DIR/scripts/globus.sh"

# The one JSON file a run keeps its state in, and the helpers that read and
# write it - including set_run_status and set_run_stage
source "$NEXTFLOW_DIR/scripts/run_state.sh"

# The parameter map a pipeline declares its defaults in and wrike_job.sh writes
# the params file from
source "$NEXTFLOW_DIR/scripts/pipeline_params.sh"

# The Wrike helper functions, plus the Wrike object IDs they act on:
# WRIKE_FOLDER_ID, WRIKE_SPACE_ID, WRIKE_WORKFLOW_ID,
# WRIKE_REQUEST_FORM_ID, WRIKE_PIPELINE_NAME_CFID,
# WRIKE_DASHBOARD_URL_CFID, and the WRIKE_CUSTOM_STATUS_IDS map
source "$NEXTFLOW_DIR/scripts/wrike_api.sh"

# The three pages every pipeline's upload script renders into the results
# folder, and the two-pass upload that lands them and everything they present
source "$NEXTFLOW_DIR/scripts/publish_dashboard.sh"
