#!/bin/bash
#
# run - Submit a pipeline request from the command line.
#
# Author: Daniel Smith
# Date:   August 12th, 2026
#
# The entry point for people who would rather not open a browser. It runs no
# pipeline itself: it builds the same task the "Bioinformatics Pipeline" request
# form builds and files it in "Dashboards", so a command-line request rejoins the
# normal path at the webhook and reaches wrike_task_handler.sh like any other.
#
# The task is staged in the bot's own Personal space, attached to, and only then
# moved into "Dashboards", so the samplesheet is always in place before the
# webhook fires. Filing an existing task fires TaskParentsAdded rather than the
# TaskCreated a form submission produces; wrike_sqs_listener.sh routes both.
#
# This runs as the Cluster Bot, like everything else here, and files the task on
# the caller's behalf - their username goes into the description. .env unsets any
# WRIKE_API_TOKEN in the environment before sourcing the bot's, so a personal
# token cannot stand in for it.
#
# Usage:     run <pipeline> <samplesheet>
#            e.g. run ampliseq /path/to/somesamples.txt
#
#            Minimally maintained. The request form is the supported way in, and
#            it asks questions this cannot - host depletion, retention, which
#            reference databases - so a request filed here takes each pipeline's
#            own defaults for all of them. Reproducing an earlier run needs the
#            form too.
# Triggers:  wrike_task_handler.sh, by way of the Wrike webhook and SQS
# Requires:  curl and jq (via call_wrike_api)
# Env:       WRIKE_API_TOKEN, NEXTFLOW_DIR, WRIKE_FOLDER_ID,
#            WRIKE_FORM_ANSWERS, the Wrike helper functions and the
#            log/warn/fail helpers, from .env
#
# Exits 0 once the request is filed - not once the pipeline finishes. The bot
# reports progress and the result on the task it prints.

set -euo pipefail

source /data/prod/nextflow/.env

# This is the only script that runs from wherever the caller was standing, and
# the shared helpers write beside themselves - fail records its message in a
# run_state.json where it finds one - so work somewhere of our own. The trap
# fires on every way out.
ORIGINAL_DIR="$PWD"

if ! WORK_DIR=$(mktemp -d); then
    fail "Could not create a temporary working directory."
fi

trap 'cd /; rm -rf "$WORK_DIR"' EXIT
cd "$WORK_DIR"

# The basenames of every pipeline in pipelines/, without the .sh suffix
available_pipelines() {
    local script list=""
    for script in "$NEXTFLOW_DIR"/pipelines/*.sh; do
        script=${script##*/}
        list+="${script%.sh} "
    done
    echo "$list"
}

# Delete a staged task that never reached "Dashboards". No webhook watches the
# staging space, so nothing downstream has seen it.
discard_staged_task() {
    call_wrike_api DELETE "tasks/$TASK_ID" > /dev/null 2>&1 || true
    warn "Discarding the staged task; nothing was submitted."
}

if [[ $# -ne 2 ]]; then
    fail "Usage: $0 <pipeline> <samplesheet>"$'\n'"Available pipelines: $(available_pipelines)"
fi

PIPELINE_INPUT="$1"
SAMPLESHEET="$2"

# Resolved against where the caller invoked us, not the scratch directory we just
# moved into. Everything below uses this one absolute path.
[[ "$SAMPLESHEET" == /* ]] || SAMPLESHEET="$ORIGINAL_DIR/$SAMPLESHEET"

# 1. Resolve the pipeline exactly as wrike_task_handler.sh will, so a bad name is
#    caught here rather than after a round trip through Wrike. Validated as a
#    name, not merely as a path: wrike_job.sh sources what it resolves to.
PIPELINE_UPPER=${PIPELINE_INPUT^^}

if [[ ! "$PIPELINE_UPPER" =~ ^[A-Z0-9_]+$ || ! -f "$NEXTFLOW_DIR/pipelines/$PIPELINE_UPPER.sh" ]]; then
    fail "Pipeline not found: $PIPELINE_INPUT"$'\n'"Available pipelines: $(available_pipelines)"
fi

# 2. Check the samplesheet. Its name travels as an HTTP header value, faces the
#    handler's extension check, and ends up naming a published artifact, so keep
#    it to characters safe in all three.
if [[ ! -r "$SAMPLESHEET" ]]; then
    fail "Samplesheet not found or not readable: $SAMPLESHEET"
fi

if [[ ! -s "$SAMPLESHEET" ]]; then
    fail "Samplesheet is empty: $SAMPLESHEET"
fi

SAMPLESHEET_NAME=${SAMPLESHEET##*/}

if [[ ! "$SAMPLESHEET_NAME" =~ ^[A-Za-z0-9._-]+\.(txt|tsv|out)$ ]]; then
    REASON="Unsupported samplesheet name: $SAMPLESHEET_NAME"
    REASON+=$'\n'"It must end in .txt, .tsv, or .out, and contain only letters,"
    REASON+=" digits, dots, dashes, and underscores."
    fail "$REASON"
fi

# 3. Find the bot's Personal space to stage the task in - the one folder it
#    always has and nothing watches. Read back from Wrike each time, since a
#    Personal space is only ever addressable as the one belonging to this token.
if ! SPACES_JSON=$(call_wrike_api GET "spaces"); then
    fail "Could not list Wrike spaces. Nothing was submitted."
fi

STAGING_SPACE_ID=$(echo "$SPACES_JSON" \
    | jq -r 'first(.data[] | select(.accessType == "Personal") | .id) // empty')

if [[ -z "$STAGING_SPACE_ID" ]]; then
    fail "The bot's Wrike account has no Personal space to stage the request in."
fi

# 4. Build the task there. The pipeline goes in lower case, as the form's options
#    spell it; the handler reads only the first word either way.
PIPELINE_CFID=$(wrike_answer_field_id pipeline)

if [[ -z "$PIPELINE_CFID" ]]; then
    fail "Wrike has no \"Pipeline\" custom field to put the request in."
fi

CUSTOM_FIELDS=$(jq -nc --arg id "$PIPELINE_CFID" --arg value "${PIPELINE_INPUT,,}" \
    '[{id: $id, value: $value}]')

# The task is the bot's, so the description is where the person behind the
# request is named.
DESCRIPTION="Submitted from the command line by $(whoami).<br />$SAMPLESHEET_NAME<br />"

# Born "Submitted", the status a request form leaves its task in. Set at creation
# so it cannot land after the handler has moved the task on to "Validating".
# Skipped when unmapped: an empty customStatus is rejected outright.
CREATE_STATUS=()
if [[ -n "${WRIKE_CUSTOM_STATUS_IDS[Submitted]:-}" ]]; then
    CREATE_STATUS=(--data-urlencode "customStatus=${WRIKE_CUSTOM_STATUS_IDS[Submitted]}")
fi

if ! TASK_JSON=$(call_wrike_api POST "folders/$STAGING_SPACE_ID/tasks" \
        --data-urlencode "title=$PIPELINE_UPPER - Dashboard" \
        --data-urlencode "description=$DESCRIPTION" \
        --data-urlencode "customFields=$CUSTOM_FIELDS" \
        "${CREATE_STATUS[@]}"); then
    REASON="Could not create the Wrike task. Nothing was submitted."
    REASON+=$'\n'"An HTTP 403 here means the bot may no longer create tasks, which points at its"
    REASON+=$'\n'"Wrike account rather than at anything you did - check that it is still a regular"
    REASON+=$'\n'"user and not a Collaborator, and tell whoever administers the Wrike space."
    fail "$REASON"
fi

# TASK_ID is read by update_wrike_add_parent and discard_staged_task
TASK_ID=$(echo "$TASK_JSON" | jq -r '.data[0].id // empty')
PERMALINK=$(echo "$TASK_JSON" | jq -r '.data[0].permalink // empty')

if [[ -z "$TASK_ID" ]]; then
    fail "Wrike accepted the task but returned no task ID. Nothing was submitted."
fi

# 5. Attach the samplesheet as raw bytes rather than multipart - that is what
#    this endpoint takes.
if ! call_wrike_api POST "tasks/$TASK_ID/attachments" \
        -H "X-File-Name: $SAMPLESHEET_NAME" \
        -H "Content-Type: application/octet-stream" \
        --data-binary "@$SAMPLESHEET" > /dev/null; then
    discard_staged_task
    fail "Could not attach $SAMPLESHEET_NAME to the staged task."
fi

# 6. File it under "Dashboards", which fires the TaskParentsAdded that puts the
#    request on the rails. The staging space is left attached; detaching it would
#    fire the TaskParentsRemoved that wrike_delete_handler.sh tears runs down on.
if ! update_wrike_add_parent "$WRIKE_FOLDER_ID" > /dev/null; then
    discard_staged_task
    fail "Could not file the task under \"Dashboards\"."
fi

log "Submitted the $PIPELINE_UPPER pipeline with $SAMPLESHEET_NAME as Wrike task $TASK_ID."
if [[ -n "$PERMALINK" ]]; then
    log "Progress and results will be reported there: $PERMALINK"
else
    log "Progress and results will be reported on that task."
fi
