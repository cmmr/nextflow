// Slurm and apptainer settings for workflows/humann/main.nf, auto-loaded by
// nextflow from the workflow's own directory.
//
// Mirrors config/taxprofiler/slurm.config: the same nodes, the same image cache,
// and databases read over the shared filesystem through the symlink nextflow
// stages them as.

process {
    executor       = 'slurm'
    scratch        = true
    resourceLimits = [ cpus: 32, memory: 900.GB, time: 24.h ]

    beforeScript   = 'export TMPDIR=$NXF_SCRATCH'

    // Translated search is what this reservation is for. bowtie2 against the
    // sample's own pangenome database is small; DIAMOND then sends whatever did
    // not map against the 34 GB UniRef90 index, and on a stool sample that is
    // most of the reads. HUMAnN is left on its default --memory-use minimum, so
    // DIAMOND blocks the index rather than holding it whole.
    //
    // A sample that runs out of time or memory is retried with more of both.
    // After that it is ignored: one sample's functional profile is not worth
    // losing every other sample's to, and HUMANN_TABLES builds from whatever
    // finished. Which samples those were is in humann/alignment-summary.tsv.
    withName: 'HUMANN_PROFILE' {
        cpus          = 16
        memory        = { 64.GB * task.attempt }
        time          = { 20.h  * task.attempt }
        errorStrategy = { task.attempt < 2 ? 'retry' : 'ignore' }
        maxRetries    = 1
    }

    // Joining reads every sample's gene family table into memory at once, and a
    // WGS sample carries hundreds of thousands of UniRef90 rows.
    //
    // Retried rather than left to terminate: this is the one task standing
    // between every sample's profile and the published tables, and the reason
    // config/taxprofiler/slurm.config retries is a transient read error that
    // this would be just as exposed to.
    withName: 'HUMANN_TABLES' {
        cpus          = 2
        memory        = 64.GB
        time          = 8.h
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/data/prod/nextflow/cache/apptainer'
    runOptions = '-B /tmp:/tmp'
}
