params {
    // Resource Capping
    max_cpus   = 32
    max_memory = 900.GB
    max_time   = 24.h
}

// Slurm Execution Settings
process {
    executor = 'slurm'
    scratch  = true

    // Point TMPDIR at the per-task scratch directory, which Nextflow creates on
    // the node's /tmp and removes when the task exits. Without this, QIIME 2's
    // cache at $TMPDIR/qiime2/$USER is one directory shared by every task on the
    // node, and its garbage collection deletes the process pools of tasks still
    // writing to them: apptainer runs each container in its own PID namespace,
    // so the pools of concurrent tasks read as belonging to dead processes.
    beforeScript = 'export TMPDIR=$NXF_SCRATCH'

    // Phylogenetic placement, against a reference of 54322 sequences in ~1550
    // alignment columns. ampliseq's labels size both of these for a reference a
    // fraction of that: CLUSTALO_ALIGN is process_medium (6 CPUs, 6 GB, 8 h),
    // and EPANG_PLACE carries only process_medium_memory, so it inherits the
    // pipeline default of one CPU and one hour to place onto a 54322-tip tree.
    withName: 'CLUSTALO_ALIGN' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: 'EPANG_PLACE' {
        cpus   = 16
        memory = { 128.GB * task.attempt }
        time   = { 12.h   * task.attempt }
    }

    // QIIME2_DIVERSITY_ALPHA asks alpha-group-significance whether diversity
    // differs between groups of samples, and a request that supplies no metadata
    // has no groups: the sheet ampliseq_samplesheet.sh writes carries only the
    // sequencing run, which is one value for every run that came off a single
    // directory. QIIME2 treats a column of one value as an error rather than as
    // nothing to test, and the subworkflow runs this against the metadata file
    // directly rather than against the columns METADATA_ALL found in it, so
    // there is no upstream switch that turns it off.
    //
    // Ignored rather than skipped: a run with samples from two sequencing runs
    // has a real batch variable and the test is worth having.
    withName: 'QIIME2_DIVERSITY_ALPHA' {
        errorStrategy = 'ignore'
    }
}

// Apptainer Container Configuration & Persistent Image Cache
apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/data/prod/nextflow/cache/apptainer'
    runOptions = '-B /tmp:/tmp'
}
