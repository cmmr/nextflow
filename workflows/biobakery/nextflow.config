// Defaults for workflows/biobakery, auto-loaded by nextflow from the workflow's
// own directory. Nothing here is specific to a host: the executor, node sizes
// and bind mounts come from a config passed with -c, such as
// config/biobakery/slurm.config, and every database from a parameter.

manifest {
    name            = 'biobakery'
    description     = 'KneadData, MetaPhlAn, HUMAnN, mOTUs, Nonpareil and EsViritu over shotgun metagenomes'
    nextflowVersion = '>=24.04.0'
}

params {
    input  = null
    outdir = null

    // Optional modules; KneadData and MetaPhlAn always run
    run_humann    = true
    run_motus     = true
    run_nonpareil = true
    run_esviritu  = true

    // KneadData. An empty kneaddata_db trims without depleting a host; otherwise
    // it is a directory holding one bowtie2 index.
    kneaddata_db               = null
    kneaddata_sequencer_source = 'NexteraPE'
    kneaddata_args             = ''
    save_clean_reads           = false

    // MetaPhlAn: a directory holding one database release
    metaphlan_db   = null
    metaphlan_args = ''

    // HUMAnN's three database directories
    humann_chocophlan      = null
    humann_uniref          = null
    humann_utility_mapping = null

    // mOTUs: the db_mOTU directory of a database matching mOTUs 3.1.0
    motus_db   = null
    motus_args = ''

    // Nonpareil: kmer or alignment
    nonpareil_mode = 'kmer'
    nonpareil_args = ''

    // EsViritu: a database directory of v3.1.0 or later, holding
    // virus_pathogen_database.fna and its metadata
    esviritu_db   = null
    esviritu_args = ''
}

includeConfig 'conf/base.config'

profiles {
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    local {
        process.executor       = 'local'
        process.resourceLimits = [ cpus: Runtime.runtime.availableProcessors(), memory: 16.GB, time: 24.h ]
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: '.'}/pipeline_info/timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: '.'}/pipeline_info/report.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: '.'}/pipeline_info/trace.txt"
}
